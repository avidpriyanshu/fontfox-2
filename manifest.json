{
  "manifest_version": 3,
  "name": "FontFox",
  "version": "0.1.0",
  "description": "Save, preview, and share font collections from the browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "tabs", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://fonts.google.com/*",
    "https://fonts.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "FontFox",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fontfox@example.com",
      "strict_min_version": "109.0"
    }
  }
}
