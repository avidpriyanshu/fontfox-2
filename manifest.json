{
  "manifest_version": 3,
  "name": "Fontmark Firefox",
  "version": "0.1.0",
  "description": "Save and preview font collections using browser bookmarks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "tabs", "activeTab"],
  "host_permissions": ["https://fonts.google.com/*", "https://fonts.googleapis.com/*"],
  "action": {
    "default_title": "Fontmark",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fontmark-firefox@example.com",
      "strict_min_version": "109.0"
    }
  }
}
